# Shared with Node; Node signs short-lived x-service-token values with it (min 32 chars).
SERVICE_TOKEN_SECRET=change-me-to-a-long-random-secret-value

# s3 in every deployed environment; local only for filesystem unit tests.
STORAGE_MODE=s3
# S3 commits are coordinated by S3 conditional writes (consistency.md §3) — no lock table.
# Never set AWS_S3_ALLOW_UNSAFE_RENAME — startup refuses it.

# AWS_ACCESS_KEY_ID=…
# AWS_SECRET_ACCESS_KEY=…
# AWS_REGION=ap-south-1
# AWS_EC2_METADATA_DISABLED=true   # off EC2: skip the instance-metadata region lookup

# Local Mongo (docker compose up -d) for protocol tests that need Node's side
# MONGODB_URL=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
