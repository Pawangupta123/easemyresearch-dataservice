# Shared with Node (Node's DATA_SERVICE_TOKEN_SECRET — the same value): Node signs the scoped
# dataset tokens and the /health x-service-token with it (min 32 chars).
SERVICE_TOKEN_SECRET=change-me-to-a-long-random-secret-value

# s3 in every deployed environment; local only for filesystem unit tests.
STORAGE_MODE=s3
# S3 commits are coordinated by S3 conditional writes (consistency.md §3) — no lock table.
# Never set AWS_S3_ALLOW_UNSAFE_RENAME — startup refuses it.

# AWS_ACCESS_KEY_ID=…
# AWS_SECRET_ACCESS_KEY=…
# AWS_REGION=ap-south-1
# AWS_EC2_METADATA_DISABLED=true   # off EC2: skip the instance-metadata region lookup

# Where the Delta tables live: s3://<bucket>/<prefix> deployed, a local folder in development.
# A dataset's tables are under <LAKE_ROOT>/datasets/<datasetId>/.
# LAKE_ROOT=./.lake

# Node's Mongo — the Data Service only reads dataset_patches from it (a read-only user deployed).
# MONGODB_DB is Node's DB_NAME. Locally: the docker replica set (docker compose up -d), never Atlas.
# MONGODB_URL=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
# MONGODB_DB=easemyresearch_dataservice_dev
