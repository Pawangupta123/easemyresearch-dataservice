# Shared with Node; Node signs short-lived x-service-token values with it (min 32 chars).
SERVICE_TOKEN_SECRET=change-me-to-a-long-random-secret-value

# s3 in every deployed environment; local only for filesystem unit tests.
STORAGE_MODE=s3

# Required on S3 — the service refuses to start without the commit lock (consistency.md §3).
AWS_S3_LOCKING_PROVIDER=dynamodb
DELTA_DYNAMO_TABLE_NAME=delta_log
# Never set AWS_S3_ALLOW_UNSAFE_RENAME — startup refuses it.

# Local docker compose stand-ins
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8001
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=ap-south-1
# MONGODB_URL=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
